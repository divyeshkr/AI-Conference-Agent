# Copy to .env and fill in. Without this file the app runs in mock mode.
# Provider: mock | openai | azure | gemini
CI_PROVIDER=mock

# --- OpenAI ---
# CI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# --- Azure OpenAI (preferred if IQVIA provides an endpoint) ---
# CI_PROVIDER=azure
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini ---
# CI_PROVIDER=gemini
# GEMINI_API_KEY=...
# CI_TEXT_MODEL=gemini-2.0-flash
# CI_VISION_MODEL=gemini-2.0-flash

# Model names are deployment names on Azure, model ids elsewhere.
CI_TEXT_MODEL=gpt-4o-mini
CI_VISION_MODEL=gpt-4o-mini
